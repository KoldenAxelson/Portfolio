# Local-only folders (private notes, Cowork output and delete staging)
/private/
/Claude outputs/
/_to_delete/

# Python caches and virtualenvs (scripts/, workbooks/ tests).
__pycache__/
.pytest_cache/
.venv/

# AI chat proxy — compiled binary and Go build leftovers (build with
# `make ai-proxy`; never commit). The glob also catches stray toolchain
# artifacts like the zero-byte `ai-proxy-go-tmp-umask` probe file.
/services/ai-proxy/ai-proxy
/services/ai-proxy/ai-proxy-*

# Hugo build output
/public/

# Workbook zips — built by `make workbooks` from workbooks/, never committed.
/static/downloads/
/resources/
.hugo_build.lock

# Downloaded toolchain (fetched by `make setup`)
/bin/

# Generated CSS (built by the Tailwind standalone binary at `make css`)
/assets/css/app.css

# Auto-generated by Hugo's esbuild (js.Build) for editor module resolution
/assets/jsconfig.json

# Secrets / local env
.env
.env.*
!.env.example

# OS / editor cruft
.DS_Store
.idea/
.vscode/
*.log
.fuse_hidden*

# wrangler / cloudflare
.wrangler/
.dev.vars

# Credentials — never commit. (Belt-and-suspenders: the AI feature keeps the
# proxy secret in env and the tunnel creds in ~/.cloudflared, not in the repo.)
*.key
*.pem
cloudflared/
*.tunnel.json
AI_PROXY_SECRET

# Claude Code per-machine settings (launch.json is shared and stays tracked)
.claude/settings.local.json

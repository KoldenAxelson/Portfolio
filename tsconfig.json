{
  "//": "Editor type-checking only. The build uses Hugo's esbuild (no tsc step). paths: the vendored Three.js build has no types, so its @types package (fetched into bin/ by `make typecheck`) stands in for it.",
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "paths": {
      "vendor/three/*": ["./bin/three-types/index.d.ts"]
    }
  },
  "include": [
    "assets/scripts/site/**/*.ts",
    "assets/scripts/pages/**/*.ts",
    "bin/phaser-types/*.d.ts"
  ]
}
